# Official multi-platform index; ARM64 manifest verified separately from hardware execution.
FROM python:3.12.15-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS runtime
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
WORKDIR /app
# The authenticated preview must serve the same font families as the renderer.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*
COPY services/api/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY services/api/ai_team /app/services/api/ai_team
COPY services/api/pyproject.toml /app/services/api/pyproject.toml
COPY infra/production /app/production
RUN pip install --no-cache-dir --no-deps /app/services/api && \
    useradd --no-create-home --uid 10001 ai-team && \
    mkdir -p /data /vault && chown 10001:10001 /data /vault
USER 10001:10001
ENTRYPOINT ["python", "/app/production/entrypoint.py"]
CMD ["python", "-m", "uvicorn", "ai_team.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Optional local rendering target. Packages come from official Debian repositories;
# no remote rendering service, model download, credentials, or inference at build.
FROM runtime AS video
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core && \
    rm -rf /var/lib/apt/lists/*
USER 10001:10001
