# Arquivo local na raiz; nunca versionar .env com dados reais.
AI_TEAM_ENVIRONMENT=development
AI_TEAM_PUBLIC_ORIGIN=http://localhost:3000
# Omitir para SQLite local em .data/ai-team.db.
# AI_TEAM_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/postgres?sslmode=require
AI_TEAM_SESSION_TTL_SECONDS=43200

# Next.js: configurar esta variável no ambiente privado da hospedagem.
# No Windows local o padrão já é http://127.0.0.1:8000.
# AI_TEAM_API_URL=https://api-privada.exemplo.com
